set(UNIX FALSE)
set(PUREC TRUE)
set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS FALSE)
set_property(GLOBAL PROPERTY FIND_LIBRARY_USE_LIB64_PATHS FALSE)

set(CMAKE_EXECUTABLE_SUFFIX "")
set(CMAKE_STATIC_LIBRARY_PREFIX "lib")
set(CMAKE_STATIC_LIBRARY_SUFFIX ".a")
set(CMAKE_FIND_LIBRARY_PREFIXES "lib")
set(CMAKE_FIND_LIBRARY_SUFFIXES ".a")
set(CMAKE_DL_LIBS "")
set(CMAKE_C_COMPILER_FORCED TRUE)
set(CMAKE_CXX_COMPILER_FORCED TRUE)

set(PUREC_C_RUNTIME
    "${PUREC_BIN}/lib/libpurefs.a" "${PUREC_BIN}/lib/libpurec.a" "${PUREC_LIBGCC}")
set(PUREC_CXX_RUNTIME
    "${PUREC_CXX_STAGE}/lib/libc++.a" "${PUREC_CXX_STAGE}/lib/libc++abi.a"
    "${PUREC_CXX_STAGE}/lib/libunwind.a" ${PUREC_C_RUNTIME})

string(REPLACE ";" " " PUREC_C_RUNTIME_ARGS "${PUREC_C_RUNTIME}")
string(REPLACE ";" " " PUREC_CXX_RUNTIME_ARGS "${PUREC_CXX_RUNTIME}")

set(PUREC_LINK_PREFIX
    "<CMAKE_LINKER> --eh-frame-hdr -T ${PUREC_LINKER_SCRIPT} -o <TARGET> ${PUREC_BIN}/lib/crt0.o <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_LINK_EXECUTABLE
    "${PUREC_LINK_PREFIX} --start-group <LINK_LIBRARIES> ${PUREC_C_RUNTIME_ARGS} --end-group")
set(CMAKE_CXX_LINK_EXECUTABLE
    "${PUREC_LINK_PREFIX} --start-group <LINK_LIBRARIES> ${PUREC_CXX_RUNTIME_ARGS} --end-group")

set(CMAKE_C_CREATE_STATIC_LIBRARY "<CMAKE_AR> qc <TARGET> <OBJECTS>" "<CMAKE_RANLIB> <TARGET>")
set(CMAKE_CXX_CREATE_STATIC_LIBRARY "<CMAKE_AR> qc <TARGET> <OBJECTS>" "<CMAKE_RANLIB> <TARGET>")
set(CMAKE_ASM_CREATE_STATIC_LIBRARY "<CMAKE_AR> qc <TARGET> <OBJECTS>" "<CMAKE_RANLIB> <TARGET>")
