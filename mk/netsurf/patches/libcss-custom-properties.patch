diff --git a/src/parse/var.c b/src/parse/var.c
new file mode 100644
index 0000000..704d86e
--- /dev/null
+++ b/src/parse/var.c
@@ -0,0 +1,275 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *                http://www.opensource.org/licenses/mit-license.php
+ *
+ * Parsing of CSS custom properties and of declarations that use var().
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include "bytecode/bytecode.h"
+#include "parse/var.h"
+#include "stylesheet.h"
+
+static bool token_is_text(const css_token *t, css_token_type type,
+		const char *text)
+{
+	size_t len = strlen(text);
+
+	if (t == NULL || t->type != type || t->idata == NULL)
+		return false;
+
+	return lwc_string_length(t->idata) == len &&
+			strncasecmp(lwc_string_data(t->idata), text, len) == 0;
+}
+
+bool css__is_custom_property_name(const css_token *token)
+{
+	if (token == NULL || token->type != CSS_TOKEN_IDENT ||
+			token->idata == NULL)
+		return false;
+
+	return lwc_string_length(token->idata) > 2 &&
+			memcmp(lwc_string_data(token->idata), "--", 2) == 0;
+}
+
+bool css__token_is_var(const css_token *token)
+{
+	return token_is_text(token, CSS_TOKEN_FUNCTION, "var");
+}
+
+bool css__vector_has_var(const parserutils_vector *vector, int32_t ctx)
+{
+	const css_token *token;
+
+	while ((token = parserutils_vector_iterate(vector, &ctx)) != NULL) {
+		if (css__token_is_var(token))
+			return true;
+	}
+
+	return false;
+}
+
+/* The lexer strips delimiters from some tokens (the '@' of at-keywords, the
+ * quotes of strings and so on). Write a token's text as it would be written
+ * in a stylesheet, or just measure it when dst is NULL. */
+static size_t token_text(const css_token *t, char *dst)
+{
+	size_t n = 0, i;
+	const char *prefix = "";
+	const char *suffix = "";
+	bool quote = false;
+
+	switch (t->type) {
+	case CSS_TOKEN_ATKEYWORD:
+		prefix = "@";
+		break;
+	case CSS_TOKEN_HASH:
+		prefix = "#";
+		break;
+	case CSS_TOKEN_PERCENTAGE:
+		suffix = "%";
+		break;
+	case CSS_TOKEN_FUNCTION:
+		suffix = "(";
+		break;
+	case CSS_TOKEN_UNICODE_RANGE:
+		prefix = "U+";
+		break;
+	case CSS_TOKEN_STRING:
+	case CSS_TOKEN_INVALID_STRING:
+		prefix = "\"";
+		suffix = t->type == CSS_TOKEN_STRING ? "\"" : "";
+		quote = true;
+		break;
+	case CSS_TOKEN_URI:
+		prefix = "url(\"";
+		suffix = "\")";
+		quote = true;
+		break;
+	case CSS_TOKEN_COMMENT:
+		return 0;
+	default:
+		break;
+	}
+
+	for (i = 0; prefix[i] != '\0'; i++) {
+		if (dst != NULL)
+			dst[n] = prefix[i];
+		n++;
+	}
+
+	for (i = 0; i < t->data.len; i++) {
+		char c = (char) t->data.data[i];
+
+		if (quote && c == '"' && (i == 0 || t->data.data[i - 1] != '\\')) {
+			if (dst != NULL)
+				dst[n] = '\\';
+			n++;
+		}
+		if (dst != NULL)
+			dst[n] = c;
+		n++;
+	}
+
+	for (i = 0; suffix[i] != '\0'; i++) {
+		if (dst != NULL)
+			dst[n] = suffix[i];
+		n++;
+	}
+
+	return n;
+}
+
+/* Turn the remaining tokens back into text, without surrounding whitespace
+ * and without a trailing !important, which is reported separately. */
+static css_error serialise_value(const parserutils_vector *vector,
+		int32_t *ctx, bool *important, lwc_string **out)
+{
+	int32_t scan = *ctx;
+	const css_token *token;
+	const css_token **tokens;
+	size_t count = 0, n = 0, first, last, total, i;
+	char *buffer, *cursor;
+	lwc_error lerror;
+
+	while (parserutils_vector_iterate(vector, &scan) != NULL)
+		count++;
+
+	tokens = malloc((count > 0 ? count : 1) * sizeof(*tokens));
+	if (tokens == NULL)
+		return CSS_NOMEM;
+
+	scan = *ctx;
+	while ((token = parserutils_vector_iterate(vector, &scan)) != NULL)
+		tokens[n++] = token;
+	*ctx = scan;
+
+	first = 0;
+	last = n;
+	*important = false;
+
+	while (last > first && tokens[last - 1]->type == CSS_TOKEN_S)
+		last--;
+
+	if (last - first >= 2 &&
+			token_is_text(tokens[last - 1], CSS_TOKEN_IDENT,
+					"important")) {
+		size_t k = last - 1;
+
+		while (k > first && tokens[k - 1]->type == CSS_TOKEN_S)
+			k--;
+
+		if (k > first && tokens[k - 1]->type == CSS_TOKEN_CHAR &&
+				tokens[k - 1]->idata != NULL &&
+				lwc_string_length(tokens[k - 1]->idata) == 1 &&
+				lwc_string_data(tokens[k - 1]->idata)[0] ==
+						'!') {
+			*important = true;
+			last = k - 1;
+			while (last > first &&
+					tokens[last - 1]->type == CSS_TOKEN_S)
+				last--;
+		}
+	}
+
+	while (first < last && tokens[first]->type == CSS_TOKEN_S)
+		first++;
+
+	total = 0;
+	for (i = first; i < last; i++)
+		total += token_text(tokens[i], NULL);
+
+	buffer = malloc(total + 1);
+	if (buffer == NULL) {
+		free(tokens);
+		return CSS_NOMEM;
+	}
+
+	cursor = buffer;
+	for (i = first; i < last; i++)
+		cursor += token_text(tokens[i], cursor);
+	*cursor = '\0';
+
+	lerror = lwc_intern_string(buffer, total, out);
+
+	free(buffer);
+	free(tokens);
+
+	return css_error_from_lwc_error(lerror);
+}
+
+css_error css__parse_var_declaration(css_language *c,
+		const css_token *name, uint32_t prop, bool custom,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_rule *rule)
+{
+	lwc_string *value = NULL;
+	css_style *style = NULL;
+	uint32_t name_index = 0, value_index = 0;
+	bool important = false;
+	css_error error;
+
+	error = serialise_value(vector, ctx, &important, &value);
+	if (error != CSS_OK)
+		return error;
+
+	if (!custom && lwc_string_length(value) == 0) {
+		lwc_string_unref(value);
+		return CSS_INVALID;
+	}
+
+	error = css__stylesheet_style_create(c->sheet, &style);
+	if (error != CSS_OK) {
+		lwc_string_unref(value);
+		return error;
+	}
+
+	if (custom) {
+		error = css__stylesheet_string_add(c->sheet,
+				lwc_string_ref(name->idata), &name_index);
+		if (error != CSS_OK) {
+			lwc_string_unref(value);
+			css__stylesheet_style_destroy(style);
+			return error;
+		}
+	}
+
+	error = css__stylesheet_string_add(c->sheet, value, &value_index);
+	if (error != CSS_OK) {
+		css__stylesheet_style_destroy(style);
+		return error;
+	}
+
+	if (custom) {
+		error = css__stylesheet_style_append(style,
+				buildOPV(CSS_OP_CUSTOM,
+					important ? FLAG_IMPORTANT : 0, 0));
+		if (error == CSS_OK)
+			error = css__stylesheet_style_append(style, name_index);
+	} else {
+		error = css__stylesheet_style_append(style,
+				buildOPV(CSS_OP_PENDING,
+					important ? FLAG_IMPORTANT : 0,
+					(uint16_t) prop));
+	}
+	if (error == CSS_OK)
+		error = css__stylesheet_style_append(style, value_index);
+	if (error != CSS_OK) {
+		css__stylesheet_style_destroy(style);
+		return error;
+	}
+
+	c->sheet->uses_var = true;
+
+	error = css__stylesheet_rule_append_style(c->sheet, rule, style);
+	if (error != CSS_OK) {
+		css__stylesheet_style_destroy(style);
+		return error;
+	}
+
+	return CSS_OK;
+}
