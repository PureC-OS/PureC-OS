+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *                http://www.opensource.org/licenses/mit-license.php
+ */
+
+#ifndef css_parse_var_h_
+#define css_parse_var_h_
+
+#include <stdbool.h>
+
+#include "parse/language.h"
+#include "stylesheet.h"
+
+/* Pseudo-opcodes for custom properties (--name: value) and for declarations
+ * whose value contains var() and so can only be parsed once the element's
+ * custom properties are known. Opcodes have ten bits, properties use the
+ * bottom of that range. */
+#define CSS_OP_CUSTOM  1022
+#define CSS_OP_PENDING 1023
+
+bool css__is_custom_property_name(const css_token *token);
+bool css__token_is_var(const css_token *token);
+bool css__vector_has_var(const parserutils_vector *vector, int32_t ctx);
+
+/* Store a custom property (custom == true) or a pending declaration of
+ * property `prop` in the rule. Consumes the rest of the vector. */
+css_error css__parse_var_declaration(css_language *c,
+		const css_token *name, uint32_t prop, bool custom,
+		const parserutils_vector *vector, int32_t *ctx,
+		css_rule *rule);
+
+#endif
