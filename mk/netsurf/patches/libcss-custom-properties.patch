diff --git a/src/select/var.c b/src/select/var.c
new file mode 100644
index 0000000..cc5d32c
--- /dev/null
+++ b/src/select/var.c
@@ -0,0 +1,911 @@
+/*
+ * This file is part of LibCSS.
+ * Licensed under the MIT License,
+ *                http://www.opensource.org/licenses/mit-license.php
+ *
+ * Custom properties (--name) and var() at selection time.
+ *
+ * Custom property declarations and declarations using var() are stored as
+ * text in the stylesheet (see parse/var.c). While an element is selected they
+ * are collected with the same cascade rules as ordinary properties. Once all
+ * of the element's sheets have been processed the custom properties are
+ * resolved (inheriting from the parent's), and the declarations that were
+ * waiting for them are substituted, parsed and cascaded in their original
+ * order.
+ */
+
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include <parserutils/input/inputstream.h>
+#include <parserutils/utils/vector.h>
+
+#include "lex/lex.h"
+#include "parse/important.h"
+#include "parse/language.h"
+#include "parse/properties/properties.h"
+#include "parse/var.h"
+#include "select/select.h"
+#include "select/var.h"
+
+#define VAR_MAX_DEPTH 32
+#define VAR_MAX_LENGTH 65536
+
+struct css_custom_prop {
+	lwc_string *name;
+	lwc_string *value;
+};
+
+struct css_custom_props {
+	uint32_t refs;
+	uint32_t count;
+	struct css_custom_prop *items;	/* sorted by name pointer */
+};
+
+struct var_custom {
+	lwc_string *name;
+	lwc_string *value;
+	css_origin origin;
+	bool important;
+	uint32_t specificity;
+	uint32_t order;
+};
+
+struct var_pending {
+	const css_stylesheet *sheet;
+	uint32_t prop;
+	lwc_string *text;
+	bool important;
+	css_origin origin;
+	uint32_t specificity;
+	uint32_t order;
+	css_pseudo_element pseudo;
+};
+
+struct css_var_state {
+	struct var_custom *customs;
+	uint32_t n_customs, cap_customs;
+	struct var_pending *pending;
+	uint32_t n_pending, cap_pending;
+};
+
+/******************************************************************************
+ * Resolved custom property sets                                              *
+ ******************************************************************************/
+
+struct css_custom_props *css__custom_props_ref(struct css_custom_props *props)
+{
+	if (props != NULL)
+		props->refs++;
+
+	return props;
+}
+
+void css__custom_props_unref(struct css_custom_props *props)
+{
+	uint32_t i;
+
+	if (props == NULL || --props->refs > 0)
+		return;
+
+	for (i = 0; i < props->count; i++) {
+		lwc_string_unref(props->items[i].name);
+		lwc_string_unref(props->items[i].value);
+	}
+
+	free(props->items);
+	free(props);
+}
+
+static int compare_items(const void *a, const void *b)
+{
+	uintptr_t x = (uintptr_t) ((const struct css_custom_prop *) a)->name;
+	uintptr_t y = (uintptr_t) ((const struct css_custom_prop *) b)->name;
+
+	return x < y ? -1 : (x > y ? 1 : 0);
+}
+
+static lwc_string *props_get(const struct css_custom_props *props,
+		lwc_string *name)
+{
+	uint32_t low = 0, high;
+	uintptr_t key = (uintptr_t) name;
+
+	if (props == NULL)
+		return NULL;
+
+	high = props->count;
+	while (low < high) {
+		uint32_t mid = low + (high - low) / 2;
+		uintptr_t at = (uintptr_t) props->items[mid].name;
+
+		if (at == key)
+			return props->items[mid].value;
+		if (at < key)
+			low = mid + 1;
+		else
+			high = mid;
+	}
+
+	return NULL;
+}
+
+/******************************************************************************
+ * Collecting declarations                                                    *
+ ******************************************************************************/
+
+static css_error var_state_get(css_select_state *state,
+		struct css_var_state **out)
+{
+	if (state->var == NULL) {
+		state->var = calloc(1, sizeof(struct css_var_state));
+		if (state->var == NULL)
+			return CSS_NOMEM;
+	}
+
+	*out = state->var;
+
+	return CSS_OK;
+}
+
+/* Same ordering as css__outranks_existing(), for custom properties. */
+static bool beats(const struct var_custom *existing,
+		const css_select_state *state, bool important)
+{
+	bool spec_wins = state->current_specificity > existing->specificity ||
+			(state->current_specificity == existing->specificity &&
+			state->current_order >= existing->order);
+
+	if (existing->origin < state->current_origin) {
+		return !(existing->important &&
+				existing->origin == CSS_ORIGIN_USER);
+	} else if (existing->origin == state->current_origin) {
+		if (existing->origin == CSS_ORIGIN_UA)
+			return spec_wins;
+		if (!existing->important && important)
+			return true;
+		if (existing->important && !important)
+			return false;
+		return spec_wins;
+	}
+
+	return state->current_origin == CSS_ORIGIN_USER && important;
+}
+
+css_error css__select_var_op(css_code_t opv, css_style *style,
+		css_select_state *state)
+{
+	struct css_var_state *var;
+	lwc_string *name = NULL, *value = NULL;
+	uint32_t name_index = 0, value_index = 0;
+	bool important = isImportant(opv);
+	css_error error;
+	uint32_t i;
+
+	if (getOpcode(opv) == CSS_OP_CUSTOM) {
+		name_index = *style->bytecode;
+		advance_bytecode(style, sizeof(css_code_t));
+	}
+	value_index = *style->bytecode;
+	advance_bytecode(style, sizeof(css_code_t));
+
+	if (getOpcode(opv) == CSS_OP_CUSTOM) {
+		/* Custom properties of pseudo-elements are not supported. */
+		if (state->current_pseudo != CSS_PSEUDO_ELEMENT_NONE)
+			return CSS_OK;
+
+		error = css__stylesheet_string_get(
+				(css_stylesheet *) state->sheet, name_index,
+				&name);
+		if (error != CSS_OK)
+			return error;
+		error = css__stylesheet_string_get(
+				(css_stylesheet *) state->sheet, value_index,
+				&value);
+		if (error != CSS_OK)
+			return error;
+
+		error = var_state_get(state, &var);
+		if (error != CSS_OK)
+			return error;
+
+		for (i = 0; i < var->n_customs; i++) {
+			if (var->customs[i].name == name)
+				break;
+		}
+
+		if (i < var->n_customs) {
+			if (!beats(&var->customs[i], state, important))
+				return CSS_OK;
+			lwc_string_unref(var->customs[i].value);
+		} else {
+			if (var->n_customs == var->cap_customs) {
+				uint32_t cap = var->cap_customs ?
+						var->cap_customs * 2 : 16;
+				struct var_custom *grown = realloc(
+						var->customs,
+						cap * sizeof(*grown));
+				if (grown == NULL)
+					return CSS_NOMEM;
+				var->customs = grown;
+				var->cap_customs = cap;
+			}
+			var->customs[i].name = lwc_string_ref(name);
+			var->n_customs++;
+		}
+
+		var->customs[i].value = lwc_string_ref(value);
+		var->customs[i].origin = state->current_origin;
+		var->customs[i].important = important;
+		var->customs[i].specificity = state->current_specificity;
+		var->customs[i].order = state->current_order;
+
+		return CSS_OK;
+	}
+
+	error = css__stylesheet_string_get((css_stylesheet *) state->sheet,
+			value_index, &value);
+	if (error != CSS_OK)
+		return error;
+
+	error = var_state_get(state, &var);
+	if (error != CSS_OK)
+		return error;
+
+	if (var->n_pending == var->cap_pending) {
+		uint32_t cap = var->cap_pending ? var->cap_pending * 2 : 16;
+		struct var_pending *grown = realloc(var->pending,
+				cap * sizeof(*grown));
+		if (grown == NULL)
+			return CSS_NOMEM;
+		var->pending = grown;
+		var->cap_pending = cap;
+	}
+
+	i = var->n_pending++;
+	var->pending[i].sheet = state->sheet;
+	var->pending[i].prop = getValue(opv);
+	var->pending[i].text = lwc_string_ref(value);
+	var->pending[i].important = important;
+	var->pending[i].origin = state->current_origin;
+	var->pending[i].specificity = state->current_specificity;
+	var->pending[i].order = state->current_order;
+	var->pending[i].pseudo = state->current_pseudo;
+
+	return CSS_OK;
+}
+
+css_error css__select_var_parent(css_select_state *state, void *parent)
+{
+	struct css_node_data *data = NULL;
+	css_error error;
+
+	state->parent_custom = NULL;
+
+	if (parent == NULL)
+		return CSS_OK;
+
+	error = state->handler->get_libcss_node_data(state->pw, parent,
+			(void **) (void *) &data);
+	if (error != CSS_OK)
+		return error;
+
+	if (data != NULL)
+		state->parent_custom = data->custom;
+
+	return CSS_OK;
+}
+
+/******************************************************************************
+ * var() substitution                                                         *
+ ******************************************************************************/
+
+struct text_buffer {
+	char *data;
+	size_t length, capacity;
+	bool failed;
+};
+
+static void buffer_append(struct text_buffer *b, const char *s, size_t n)
+{
+	if (b->failed)
+		return;
+
+	if (b->length + n + 1 > b->capacity) {
+		size_t cap = b->capacity ? b->capacity : 128;
+		char *grown;
+
+		while (cap < b->length + n + 1)
+			cap *= 2;
+		grown = realloc(b->data, cap);
+		if (grown == NULL) {
+			b->failed = true;
+			return;
+		}
+		b->data = grown;
+		b->capacity = cap;
+	}
+
+	memcpy(b->data + b->length, s, n);
+	b->length += n;
+	b->data[b->length] = '\0';
+}
+
+struct resolve_ctx {
+	const struct css_custom_props *inherited;
+	struct var_custom *own;
+	uint32_t n_own;
+	uint8_t *own_state;		/* 0 todo, 1 busy, 2 valid, 3 invalid */
+	char **own_text;
+	size_t *own_length;
+};
+
+static bool substitute(struct resolve_ctx *rc, const char *text, size_t length,
+		unsigned depth, struct text_buffer *out);
+
+static bool resolve_own(struct resolve_ctx *rc, uint32_t index)
+{
+	const char *raw;
+	struct text_buffer out = {NULL, 0, 0, false};
+	bool valid;
+
+	if (rc->own_state[index] == 2)
+		return true;
+	if (rc->own_state[index] != 0)
+		return false;
+
+	rc->own_state[index] = 1;
+
+	raw = lwc_string_data(rc->own[index].value);
+	valid = substitute(rc, raw, lwc_string_length(rc->own[index].value), 0,
+			&out);
+
+	if (valid && !out.failed) {
+		size_t start = 0, end = out.length;
+
+		while (start < end && (out.data[start] == ' ' ||
+				out.data[start] == '\t' ||
+				out.data[start] == '\n'))
+			start++;
+		while (end > start && (out.data[end - 1] == ' ' ||
+				out.data[end - 1] == '\t' ||
+				out.data[end - 1] == '\n'))
+			end--;
+
+		if (end - start == 7 &&
+				strncasecmp(out.data + start, "initial", 7) == 0) {
+			valid = false;
+		} else if ((end - start == 7 &&
+				strncasecmp(out.data + start, "inherit", 7) == 0)
+				|| (end - start == 5 &&
+				strncasecmp(out.data + start, "unset", 5) == 0)) {
+			lwc_string *parent_value = props_get(rc->inherited,
+					rc->own[index].name);
+
+			if (parent_value == NULL) {
+				valid = false;
+			} else {
+				free(out.data);
+				out.data = NULL;
+				out.length = 0;
+				out.capacity = 0;
+				buffer_append(&out,
+					lwc_string_data(parent_value),
+					lwc_string_length(parent_value));
+				start = 0;
+				end = out.length;
+			}
+		}
+
+		if (valid) {
+			rc->own_text[index] = malloc(end - start + 1);
+			if (rc->own_text[index] == NULL) {
+				valid = false;
+			} else {
+				memcpy(rc->own_text[index], out.data + start,
+						end - start);
+				rc->own_text[index][end - start] = '\0';
+				rc->own_length[index] = end - start;
+			}
+		}
+	} else {
+		valid = false;
+	}
+
+	free(out.data);
+	rc->own_state[index] = valid ? 2 : 3;
+
+	return valid;
+}
+
+/* Look a custom property up; the text is valid until the context is freed. */
+static bool lookup(struct resolve_ctx *rc, lwc_string *name, const char **text,
+		size_t *length)
+{
+	uint32_t i;
+	lwc_string *value;
+
+	for (i = 0; i < rc->n_own; i++) {
+		if (rc->own[i].name != name)
+			continue;
+		if (!resolve_own(rc, i))
+			return false;
+		*text = rc->own_text[i];
+		*length = rc->own_length[i];
+		return true;
+	}
+
+	value = props_get(rc->inherited, name);
+	if (value == NULL)
+		return false;
+
+	*text = lwc_string_data(value);
+	*length = lwc_string_length(value);
+
+	return true;
+}
+
+static bool is_space(char c)
+{
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f';
+}
+
+static bool is_ident_char(char c)
+{
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+			(c >= '0' && c <= '9') || c == '-' || c == '_' ||
+			((unsigned char) c) >= 0x80;
+}
+
+static size_t skip_string(const char *text, size_t length, size_t i)
+{
+	char quote = text[i++];
+
+	while (i < length && text[i] != quote) {
+		if (text[i] == '\\' && i + 1 < length)
+			i++;
+		i++;
+	}
+
+	return i < length ? i + 1 : length;
+}
+
+/* Replace every var() in text; false if the value cannot be computed. */
+static bool substitute(struct resolve_ctx *rc, const char *text, size_t length,
+		unsigned depth, struct text_buffer *out)
+{
+	size_t i = 0;
+
+	if (depth > VAR_MAX_DEPTH)
+		return false;
+
+	while (i < length) {
+		char c = text[i];
+
+		if (out->length > VAR_MAX_LENGTH)
+			return false;
+
+		if (c == '"' || c == '\'') {
+			size_t end = skip_string(text, length, i);
+
+			buffer_append(out, text + i, end - i);
+			i = end;
+			continue;
+		}
+
+		if (i + 4 <= length && strncasecmp(text + i, "var(", 4) == 0 &&
+				(i == 0 || !is_ident_char(text[i - 1]))) {
+			size_t j = i + 4, inner_start = i + 4, inner_end;
+			unsigned nesting = 1;
+			size_t name_start, name_end, fallback_start = 0;
+			bool has_fallback = false;
+			lwc_string *name = NULL;
+			const char *found;
+			size_t found_length;
+			bool ok;
+
+			while (j < length && nesting > 0) {
+				if (text[j] == '"' || text[j] == '\'') {
+					j = skip_string(text, length, j);
+					continue;
+				}
+				if (text[j] == '(')
+					nesting++;
+				else if (text[j] == ')')
+					nesting--;
+				j++;
+			}
+			if (nesting != 0)
+				return false;
+			inner_end = j - 1;
+
+			name_start = inner_start;
+			while (name_start < inner_end &&
+					is_space(text[name_start]))
+				name_start++;
+			name_end = name_start;
+			while (name_end < inner_end && !is_space(text[name_end])
+					&& text[name_end] != ',')
+				name_end++;
+			if (name_end - name_start < 3 ||
+					memcmp(text + name_start, "--", 2) != 0)
+				return false;
+
+			fallback_start = name_end;
+			while (fallback_start < inner_end &&
+					is_space(text[fallback_start]))
+				fallback_start++;
+			if (fallback_start < inner_end) {
+				if (text[fallback_start] != ',')
+					return false;
+				has_fallback = true;
+				fallback_start++;
+				while (fallback_start < inner_end &&
+						is_space(text[fallback_start]))
+					fallback_start++;
+			}
+
+			if (lwc_intern_string(text + name_start,
+					name_end - name_start, &name) !=
+					lwc_error_ok)
+				return false;
+
+			ok = lookup(rc, name, &found, &found_length);
+			lwc_string_unref(name);
+
+			if (ok) {
+				buffer_append(out, found, found_length);
+			} else if (has_fallback) {
+				size_t fallback_end = inner_end;
+
+				while (fallback_end > fallback_start &&
+						is_space(text[fallback_end - 1]))
+					fallback_end--;
+				if (!substitute(rc, text + fallback_start,
+						fallback_end - fallback_start,
+						depth + 1, out))
+					return false;
+			} else {
+				return false;
+			}
+
+			i = j;
+			continue;
+		}
+
+		buffer_append(out, &text[i], 1);
+		i++;
+	}
+
+	return !out->failed;
+}
+
+/******************************************************************************
+ * Applying declarations that used var()                                      *
+ ******************************************************************************/
+
+static css_error compile(const css_stylesheet *sheet, uint32_t prop,
+		const char *text, size_t length, css_style **out)
+{
+	css_language language;
+	parserutils_inputstream *stream = NULL;
+	css_lexer *lexer = NULL;
+	parserutils_vector *vector = NULL;
+	css_style *style = NULL;
+	css_error error;
+	int32_t ctx = 0;
+	const css_token *token;
+	bool previous_space = false;
+
+	memset(&language, 0, sizeof(language));
+	language.sheet = (css_stylesheet *) sheet;
+	language.strings = sheet->propstrings;
+
+	if (parserutils_inputstream_create("UTF-8", CSS_CHARSET_DICTATED, NULL,
+			&stream) != PARSERUTILS_OK)
+		return CSS_NOMEM;
+
+	if (parserutils_inputstream_append(stream, (const uint8_t *) text,
+			length) != PARSERUTILS_OK ||
+			parserutils_inputstream_append(stream, NULL, 0) !=
+			PARSERUTILS_OK) {
+		parserutils_inputstream_destroy(stream);
+		return CSS_NOMEM;
+	}
+
+	error = css__lexer_create(stream, &lexer);
+	if (error != CSS_OK) {
+		parserutils_inputstream_destroy(stream);
+		return error;
+	}
+
+	if (parserutils_vector_create(sizeof(css_token), 32, &vector) !=
+			PARSERUTILS_OK) {
+		css__lexer_destroy(lexer);
+		parserutils_inputstream_destroy(stream);
+		return CSS_NOMEM;
+	}
+
+	for (;;) {
+		css_token *t;
+
+		error = css__lexer_get_token(lexer, &t);
+		if (error != CSS_OK || t->type == CSS_TOKEN_EOF)
+			break;
+
+		if (previous_space && t->type == CSS_TOKEN_S)
+			continue;
+
+		if (t->type < CSS_TOKEN_LAST_INTERN && t->data.data != NULL) {
+			if (lwc_intern_string((char *) t->data.data,
+					t->data.len, &t->idata) !=
+					lwc_error_ok) {
+				error = CSS_NOMEM;
+				break;
+			}
+		} else {
+			t->idata = NULL;
+		}
+
+		if (parserutils_vector_append(vector, t) != PARSERUTILS_OK) {
+			if (t->idata != NULL)
+				lwc_string_unref(t->idata);
+			error = CSS_NOMEM;
+			break;
+		}
+
+		previous_space = t->type == CSS_TOKEN_S;
+	}
+
+	if (error == CSS_OK)
+		error = css__stylesheet_style_create(
+				(css_stylesheet *) sheet, &style);
+
+	if (error == CSS_OK) {
+		consumeWhitespace(vector, &ctx);
+
+		error = property_handlers[prop - FIRST_PROP](&language, vector,
+				&ctx, style);
+		if (error == CSS_OK) {
+			consumeWhitespace(vector, &ctx);
+			if (parserutils_vector_iterate(vector, &ctx) != NULL)
+				error = CSS_INVALID;
+		}
+	}
+
+	ctx = 0;
+	while ((token = parserutils_vector_iterate(vector, &ctx)) != NULL) {
+		if (token->idata != NULL)
+			lwc_string_unref(token->idata);
+	}
+	parserutils_vector_destroy(vector);
+	css__lexer_destroy(lexer);
+	parserutils_inputstream_destroy(stream);
+
+	if (error != CSS_OK) {
+		if (style != NULL)
+			css__stylesheet_style_destroy(style);
+		return error;
+	}
+
+	*out = style;
+
+	return CSS_OK;
+}
+
+static css_error replay_pending(css_select_state *state,
+		struct css_var_state *var, struct resolve_ctx *rc)
+{
+	const css_stylesheet *saved_sheet = state->sheet;
+	css_origin saved_origin = state->current_origin;
+	uint32_t saved_specificity = state->current_specificity;
+	uint32_t saved_order = state->current_order;
+	css_pseudo_element saved_pseudo = state->current_pseudo;
+	css_computed_style *saved_computed = state->computed;
+	css_error result = CSS_OK;
+	uint32_t i;
+
+	for (i = 0; i < var->n_pending && result == CSS_OK; i++) {
+		struct var_pending *p = &var->pending[i];
+		struct text_buffer out = {NULL, 0, 0, false};
+		css_style *style = NULL;
+		css_error error;
+
+		if (state->results->styles[p->pseudo] == NULL)
+			continue;
+
+		if (!substitute(rc, lwc_string_data(p->text),
+				lwc_string_length(p->text), 0, &out) ||
+				out.failed || out.length == 0) {
+			/* Invalid at computed-value time: the declaration
+			 * still wins the cascade, as 'unset'. */
+			free(out.data);
+			out.data = strdup("unset");
+			if (out.data == NULL) {
+				result = CSS_NOMEM;
+				break;
+			}
+			out.length = 5;
+			out.failed = false;
+		}
+
+		error = compile(p->sheet, p->prop, out.data, out.length,
+				&style);
+		free(out.data);
+		if (error == CSS_NOMEM) {
+			result = error;
+			break;
+		}
+		if (error != CSS_OK)
+			continue;
+
+		if (p->important)
+			css__make_style_important(style);
+
+		state->sheet = p->sheet;
+		state->current_origin = p->origin;
+		state->current_specificity = p->specificity;
+		state->current_order = p->order;
+		state->current_pseudo = p->pseudo;
+		state->computed = state->results->styles[p->pseudo];
+
+		result = css__select_var_replay_style(style, state);
+
+		css__stylesheet_style_destroy(style);
+	}
+
+	state->sheet = saved_sheet;
+	state->current_origin = saved_origin;
+	state->current_specificity = saved_specificity;
+	state->current_order = saved_order;
+	state->current_pseudo = saved_pseudo;
+	state->computed = saved_computed;
+
+	return result;
+}
+
+css_error css__select_var_finish(css_select_state *state)
+{
+	struct css_var_state *var = state->var;
+	struct css_custom_props *map = NULL;
+	struct resolve_ctx rc;
+	css_error error = CSS_OK;
+	uint32_t i, valid = 0, inherited_count = 0, n = 0;
+
+	if (!state->need_var)
+		return CSS_OK;
+
+	if (var == NULL || var->n_customs == 0) {
+		state->node_data->custom =
+				css__custom_props_ref(state->parent_custom);
+		if (var == NULL || var->n_pending == 0)
+			return CSS_OK;
+
+		memset(&rc, 0, sizeof(rc));
+		rc.inherited = state->parent_custom;
+
+		return replay_pending(state, var, &rc);
+	}
+
+	memset(&rc, 0, sizeof(rc));
+	rc.inherited = state->parent_custom;
+	rc.own = var->customs;
+	rc.n_own = var->n_customs;
+	rc.own_state = calloc(var->n_customs, sizeof(uint8_t));
+	rc.own_text = calloc(var->n_customs, sizeof(char *));
+	rc.own_length = calloc(var->n_customs, sizeof(size_t));
+	if (rc.own_state == NULL || rc.own_text == NULL ||
+			rc.own_length == NULL) {
+		error = CSS_NOMEM;
+		goto done;
+	}
+
+	for (i = 0; i < var->n_customs; i++) {
+		if (resolve_own(&rc, i))
+			valid++;
+	}
+
+	if (state->parent_custom != NULL)
+		inherited_count = state->parent_custom->count;
+
+	map = calloc(1, sizeof(*map));
+	if (map == NULL) {
+		error = CSS_NOMEM;
+		goto done;
+	}
+	map->refs = 1;
+	map->items = malloc((inherited_count + valid + 1) *
+			sizeof(struct css_custom_prop));
+	if (map->items == NULL) {
+		free(map);
+		map = NULL;
+		error = CSS_NOMEM;
+		goto done;
+	}
+
+	for (i = 0; i < inherited_count; i++) {
+		struct css_custom_prop *item = &state->parent_custom->items[i];
+		uint32_t k;
+		bool overridden = false;
+
+		for (k = 0; k < var->n_customs; k++) {
+			if (var->customs[k].name == item->name) {
+				overridden = true;
+				break;
+			}
+		}
+		if (overridden)
+			continue;
+
+		map->items[n].name = lwc_string_ref(item->name);
+		map->items[n].value = lwc_string_ref(item->value);
+		n++;
+	}
+
+	for (i = 0; i < var->n_customs; i++) {
+		lwc_string *value = NULL;
+
+		if (rc.own_state[i] != 2)
+			continue;
+		if (lwc_intern_string(rc.own_text[i], rc.own_length[i],
+				&value) != lwc_error_ok) {
+			error = CSS_NOMEM;
+			break;
+		}
+
+		map->items[n].name = lwc_string_ref(var->customs[i].name);
+		map->items[n].value = value;
+		n++;
+	}
+
+	map->count = n;
+	qsort(map->items, map->count, sizeof(struct css_custom_prop),
+			compare_items);
+
+	state->node_data->custom = map;
+
+	/* Pending declarations see the resolved set, not the raw one. */
+	{
+		struct resolve_ctx final;
+
+		memset(&final, 0, sizeof(final));
+		final.inherited = map;
+
+		if (error == CSS_OK)
+			error = replay_pending(state, var, &final);
+	}
+
+done:
+	if (rc.own_text != NULL) {
+		for (i = 0; i < var->n_customs; i++)
+			free(rc.own_text[i]);
+	}
+	free(rc.own_text);
+	free(rc.own_state);
+	free(rc.own_length);
+
+	return error;
+}
+
+void css__select_var_cleanup(css_select_state *state)
+{
+	struct css_var_state *var = state->var;
+	uint32_t i;
+
+	if (var == NULL)
+		return;
+
+	for (i = 0; i < var->n_customs; i++) {
+		lwc_string_unref(var->customs[i].name);
+		lwc_string_unref(var->customs[i].value);
+	}
+	for (i = 0; i < var->n_pending; i++)
+		lwc_string_unref(var->pending[i].text);
+
+	free(var->customs);
+	free(var->pending);
+	free(var);
+	state->var = NULL;
+}
