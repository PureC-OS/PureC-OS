+ *
+ * Custom properties (--name) and var() at selection time.
+ */
+
+#ifndef css_select_var_h_
+#define css_select_var_h_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <libcss/errors.h>
+
+#include "bytecode/bytecode.h"
+#include "stylesheet.h"
+
+struct css_select_state;
+struct css_select_handler;
+struct css_custom_props;
+struct css_var_state;
+
+struct css_custom_props *css__custom_props_ref(struct css_custom_props *props);
+void css__custom_props_unref(struct css_custom_props *props);
+
+/** Find the custom properties of a node's parent (they are inherited). */
+css_error css__select_var_parent(struct css_select_state *state, void *parent);
+
+/** Cascade a CSS_OP_CUSTOM or CSS_OP_PENDING item of a style. */
+css_error css__select_var_op(css_code_t opv, css_style *style,
+		struct css_select_state *state);
+
+/** Resolve the custom properties of the node and apply the declarations
+ * that were waiting for them. */
+css_error css__select_var_finish(struct css_select_state *state);
+
+/** Cascade a style without changing the declaration order (implemented in
+ * select.c, which owns the cascade). */
+css_error css__select_var_replay_style(css_style *style,
+		struct css_select_state *state);
+
+void css__select_var_cleanup(struct css_select_state *state);
+
+#endif
