timeout: 10
verbose: yes
term_foreground: FFFFFF
serial: yes

/PureC OS 64-bit Limine+GOP (primary)
    protocol: limine
    resolution: 1920x1080x32
    kernel_path: boot():/boot/kernel.elf
    module_path: boot():/boot/kernel-fallback.elf
    module_path: boot():/EFI/BOOT/BOOTX64.EFI
@MODULES@

/PureC OS 64-bit (fallback previous image)
    protocol: limine
    resolution: 1920x1080x32
    kernel_path: boot():/boot/kernel-fallback.elf
    module_path: boot():/EFI/BOOT/BOOTX64.EFI
@MODULES@

/PureC OS 64-bit (safe: all syscalls on CPU0)
    protocol: limine
    resolution: 1920x1080x32
    kernel_path: boot():/boot/kernel.elf
    kernel_cmdline: syscalls=cpu0

/PureC OS 64-bit (verbose kernel log on tty1)
    protocol: limine
    resolution: 1920x1080x32
    kernel_path: boot():/boot/kernel.elf
    kernel_cmdline: verbose
    module_path: boot():/boot/kernel-fallback.elf
    module_path: boot():/EFI/BOOT/BOOTX64.EFI
@MODULES@
