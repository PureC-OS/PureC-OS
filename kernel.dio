            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="subsystems" name="03 · Подсистемы и взаимодействие">
        <mxGraphModel dx="3460" dy="1353" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1330" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#20354c;fontSize=30;fontStyle=1;" value="PureC OS · Подсистемы работающей системы" vertex="1">
                    <mxGeometry height="50" width="1460" x="50" y="25" as="geometry"/>
                </mxCell>
                <mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#20354c;fontSize=15;fontStyle=1;" value="Стрелки показывают обращения между подсистемами, а не порядок загрузки. Все синие и фиолетовые блоки выполняются в Ring 0." vertex="1">
                    <mxGeometry height="45" width="1460" x="50" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4f4ee;strokeColor=#38836c;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Приложения · Ring 3&lt;/b&gt;&lt;br&gt;init, login, terminal, installer, monitor, files, игры.&lt;br&gt;ELF-программы + пользовательские библиотеки.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/programs • src/libc • src/libgui • src/libfs&lt;/font&gt;" vertex="1">
                    <mxGeometry height="95" width="780" x="390" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="abi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1fc;strokeColor=#4875aa;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Граница ABI: int 0x80&lt;/b&gt;&lt;br&gt;IDT / сохранение контекста → syscall_handler.&lt;br&gt;Проверка памяти процесса, диспетчер системных вызовов.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/kernel/syscall&lt;/font&gt;" vertex="1">
                    <mxGeometry height="95" width="780" x="390" y="305" as="geometry"/>
                </mxCell>
                <mxCell id="proc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1fc;strokeColor=#4875aa;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Процессы и SMP scheduler&lt;/b&gt;&lt;br&gt;PID, parent, args/env, fd, wait/exit.&lt;br&gt;Общая очередь; состояние на CPU, affinity.&lt;br&gt;GDT/TSS, FPU, CR3; LAPIC timer / IPI.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/kernel/process • src/kernel/smp&lt;/font&gt;" vertex="1">
                    <mxGeometry height="135" width="440" x="50" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="desktop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1fc;strokeColor=#4875aa;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Desktop и окна · Ring 0&lt;/b&gt;&lt;br&gt;userspace_init, window_manager, панели.&lt;br&gt;input / keyboard / log threads.&lt;br&gt;Обслуживание GUI-вызовов приложений.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/userspace&lt;/font&gt;" vertex="1">
                    <mxGeometry height="135" width="440" x="560" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="vfs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1fc;strokeColor=#4875aa;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Файловая система&lt;/b&gt;&lt;br&gt;VFS read/open/stat/seek и запись на диск.&lt;br&gt;Initramfs, виртуальные файлы /kernel.&lt;br&gt;Дисковые backend: ext2 и FAT32.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/fs&lt;/font&gt;" vertex="1">
                    <mxGeometry height="135" width="440" x="1070" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="mem" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0eafa;strokeColor=#8462a7;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Память и синхронизация&lt;/b&gt;&lt;br&gt;PMM: физические страницы / bitmap.&lt;br&gt;VMM: таблицы страниц, USER/NX, TLB.&lt;br&gt;Spinlock и рекурсивные mutex.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/mm • src/kernel/sync&lt;/font&gt;" vertex="1">
                    <mxGeometry height="135" width="440" x="50" y="715" as="geometry"/>
                </mxCell>
                <mxCell id="io" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1fc;strokeColor=#4875aa;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Ввод, графика, аудио&lt;/b&gt;&lt;br&gt;Keyboard, PS/2 и USB mouse.&lt;br&gt;Framebuffer/GOP; HDA / PC speaker.&lt;br&gt;Рабочий стол опрашивает события ввода.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/drivers • src/userspace/display.c&lt;/font&gt;" vertex="1">
                    <mxGeometry height="135" width="440" x="560" y="715" as="geometry"/>
                </mxCell>
                <mxCell id="block" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1fc;strokeColor=#4875aa;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Блочные устройства&lt;/b&gt;&lt;br&gt;Единый block_device API.&lt;br&gt;ATA PIO / AHCI, USB storage.&lt;br&gt;USB-контроллеры xHCI / EHCI.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/drivers/storage • src/drivers/usb&lt;/font&gt;" vertex="1">
                    <mxGeometry height="135" width="440" x="1070" y="715" as="geometry"/>
                </mxCell>
                <mxCell id="net" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1fc;strokeColor=#4875aa;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Сеть&lt;/b&gt;&lt;br&gt;net_service / net-rx → сетевой стек.&lt;br&gt;Ethernet, ARP, IPv4, UDP, DHCP, DNS, ICMP.&lt;br&gt;Драйверы e1000 / 82543gc / pcnet; Wi-Fi код.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/net • src/drivers/net&lt;/font&gt;" vertex="1">
                    <mxGeometry height="135" width="440" x="50" y="945" as="geometry"/>
                </mxCell>
                <mxCell id="devices" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1fc;strokeColor=#4875aa;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;PCI / ACPI и устройства&lt;/b&gt;&lt;br&gt;devman: перечисление PCI и ACPI.&lt;br&gt;power_init, uACPI, питание и датчики.&lt;br&gt;MMIO mapper для регистров устройств.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/kernel/devices • src/drivers/power • acpi&lt;/font&gt;" vertex="1">
                    <mxGeometry height="135" width="440" x="560" y="945" as="geometry"/>
                </mxCell>
                <mxCell id="diag" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#bb5650;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Диагностика&lt;/b&gt;&lt;br&gt;serial, klog, boot_diag.&lt;br&gt;Исключения → kernel_panic_exception.&lt;br&gt;Паника: регистры, call trace, остановка CPU.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/kernel/diagnostics&lt;/font&gt;" vertex="1">
                    <mxGeometry height="135" width="440" x="1070" y="945" as="geometry"/>
                </mxCell>
                <mxCell id="scope" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8d9;strokeColor=#bf9b3b;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Текущие ограничения архитектуры&lt;/b&gt;&lt;br&gt;Драйверы и desktop слинкованы с ядром. Наличие .ko / .elf в конфигурации Limine ещё не означает динамическую загрузку драйверов.&lt;br&gt;Boot-модули Limine, архив initramfs и процессы ELF — разные сущности. Схема показывает существующие связи, без планируемого module loader." vertex="1">
                    <mxGeometry height="105" width="1460" x="50" y="1160" as="geometry"/>
                </mxCell>
                <mxCell id="edge1" edge="1" parent="1" source="user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64778b;strokeWidth=2;fontSize=12;fontColor=#33475b;labelBackgroundColor=#ffffff;" target="abi" value="syscalls">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge2" edge="1" parent="1" source="abi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64778b;strokeWidth=2;fontSize=12;fontColor=#33475b;labelBackgroundColor=#ffffff;" target="proc" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge3" edge="1" parent="1" source="abi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64778b;strokeWidth=2;fontSize=12;fontColor=#33475b;labelBackgroundColor=#ffffff;" target="desktop" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge4" edge="1" parent="1" source="abi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64778b;strokeWidth=2;fontSize=12;fontColor=#33475b;labelBackgroundColor=#ffffff;" target="vfs" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge5" edge="1" parent="1" source="proc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64778b;strokeWidth=2;fontSize=12;fontColor=#33475b;labelBackgroundColor=#ffffff;" target="mem" value="страницы, блокировки">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge6" edge="1" parent="1" source="desktop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64778b;strokeWidth=2;fontSize=12;fontColor=#33475b;labelBackgroundColor=#ffffff;" target="io" value="ввод / вывод">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge7" edge="1" parent="1" source="vfs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64778b;strokeWidth=2;fontSize=12;fontColor=#33475b;labelBackgroundColor=#ffffff;" target="block" value="FAT32 / ext2 I/O">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge8" edge="1" parent="1" source="abi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64778b;strokeWidth=2;fontSize=12;fontColor=#33475b;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" target="net" value="сетевые вызовы">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="25" y="350"/>
                            <mxPoint x="25" y="1010"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edge9" edge="1" parent="1" source="devices" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64778b;strokeWidth=2;fontSize=12;fontColor=#33475b;labelBackgroundColor=#ffffff;dashed=1;" target="io" value="обнаружение / настройка">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="filesystems" name="04 · Initramfs, ESP и дисковый root">
        <mxGraphModel dx="1900" dy="1353" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1410" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#20354c;fontSize=29;fontStyle=1;" value="От сборки архива до загрузки установленной системы" vertex="1">
                    <mxGeometry height="50" width="1460" x="50" y="25" as="geometry"/>
                </mxCell>
                <mxCell id="sub" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#20354c;fontSize=15;fontStyle=1;" value="ESP остаётся FAT32 при выборе как FAT32, так и ext2 для системного раздела. Initramfs монтируется из памяти, переданной Limine." vertex="1">
                    <mxGeometry height="45" width="1460" x="50" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="manifest" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#bb761c;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Сборка: assets/manifest.txt&lt;/b&gt;&lt;br&gt;Пути программ, библиотек, заголовков и ресурсов.&lt;br&gt;mk/gen_assets.py → CPIO newc + конфигурация ISO.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;mk/main.mk • mk/gen_assets.py&lt;/font&gt;" vertex="1">
                    <mxGeometry height="110" width="630" x="60" y="165" as="geometry"/>
                </mxCell>
                <mxCell id="iso" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#bb761c;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Загрузка ISO&lt;/b&gt;&lt;br&gt;boot/kernel.elf + /boot/initramfs.cpio.&lt;br&gt;Limine передаёт архив как boot module в RAM.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/boot/limine.conf.in&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="630" x="60" y="335" as="geometry"/>
                </mxCell>
                <mxCell id="install" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#bb761c;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Установщик&lt;/b&gt;&lt;br&gt;fat32_format_uefi_device_progress_ex(): GPT.&lt;br&gt;ESP: FAT32 → bootloader, ядра, initramfs, limine.conf.&lt;br&gt;Системный раздел: FAT32 либо ext2 → программы.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/fs/fat/fat32.c • src/fs/ext2/format.c&lt;/font&gt;" vertex="1">
                    <mxGeometry height="130" width="630" x="870" y="165" as="geometry"/>
                </mxCell>
                <mxCell id="esp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#bb761c;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Загрузка установленной системы&lt;/b&gt;&lt;br&gt;Limine с ESP: kernel.elf или kernel2.elf.&lt;br&gt;Архив: /boot/initra~1.cpi (8.3 alias).&lt;br&gt;Длинное имя на ESP: initramfs.cpio." vertex="1">
                    <mxGeometry height="120" width="630" x="870" y="350" as="geometry"/>
                </mxCell>
                <mxCell id="get" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0eafa;strokeColor=#8462a7;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Единый поиск boot-архива&lt;/b&gt;&lt;br&gt;initramfs_boot_image(): initramfs.cpio или initra~1.cpi.&lt;br&gt;Также принимает /boot/INITRA~1.CPI.&lt;br&gt;boot_get_module() возвращает адрес и размер из Limine.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/fs/initramfs.c • src/boot/boot.c&lt;/font&gt;" vertex="1">
                    <mxGeometry height="125" width="780" x="390" y="545" as="geometry"/>
                </mxCell>
                <mxCell id="mount" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0eafa;strokeColor=#8462a7;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;vfs_mount_initramfs()&lt;/b&gt;&lt;br&gt;После PMM/VMM: проверка CPIO, индекс файлов.&lt;br&gt;Начальный VFS root = INITRAMFS; данные остаются в RAM.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/kernel/core/kernel.c • src/fs/initramfs.c&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="780" x="390" y="720" as="geometry"/>
                </mxCell>
                <mxCell id="root" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1fc;strokeColor=#4875aa;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Позже: syscall_init() → vfs_mount_root()&lt;/b&gt;&lt;br&gt;Автопоиск root: ext2_init(), затем fat32_init().&lt;br&gt;Успех переключает дисковый backend; архив остаётся доступным.&lt;br&gt;Отсутствие дискового root не мешает запуску из initramfs.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/kernel/syscall/syscall.c • src/fs/vfs.c&lt;/font&gt;" vertex="1">
                    <mxGeometry height="125" width="780" x="390" y="870" as="geometry"/>
                </mxCell>
                <mxCell id="exec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4f4ee;strokeColor=#38836c;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Запуск программы&lt;/b&gt;&lt;br&gt;process_spawn_module: поиск в initramfs / alias.&lt;br&gt;Если файла нет — чтение через VFS.&lt;br&gt;Найденный образ → process_spawn_elf.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/kernel/process/process.c&lt;/font&gt;" vertex="1">
                    <mxGeometry height="120" width="630" x="60" y="1070" as="geometry"/>
                </mxCell>
                <mxCell id="access" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f1fc;strokeColor=#4875aa;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Обычное чтение файла&lt;/b&gt;&lt;br&gt;VFS: /kernel и log special files; затем initramfs.&lt;br&gt;Если в архиве нет файла — дисковый backend.&lt;br&gt;Запись: выбранный FAT32 / ext2; архив read-only.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#536174&quot;&gt;src/fs/vfs.c&lt;/font&gt;" vertex="1">
                    <mxGeometry height="120" width="630" x="870" y="1070" as="geometry"/>
                </mxCell>
                <mxCell id="caution" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8d9;strokeColor=#bf9b3b;fontColor=#172638;fontSize=15;align=left;verticalAlign=middle;spacing=15;arcSize=10;" value="&lt;b&gt;Особенность текущего VFS&lt;/b&gt;&lt;br&gt;Это не универсальная таблица mount points: используется vfs_active_fs и отдельный поиск в initramfs.&lt;br&gt;При open/stat файлы архива имеют приоритет над диском; list/list_long зависят от активного backend.&lt;br&gt;Поэтому содержимое каталога и приоритет чтения сейчас могут различаться." vertex="1">
                    <mxGeometry height="115" width="1440" x="60" y="1250" as="geometry"/>
                </mxCell>
